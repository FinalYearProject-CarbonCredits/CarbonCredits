# CarbonChain — Environment Configuration
# Copy to .env and fill in values

# ─── JWT Secret ───
# REQUIRED in production (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
# In development: auto-set to a weak default if empty
CARBONCHAIN_SECRET=

# ─── Environment Mode ───
# "development" (default) or "production"
# In production: requires CARBONCHAIN_SECRET ≥32 chars, enables HTTPS redirect, disables reload
CARBONCHAIN_ENV=development

# ─── Database ───
# Default: SQLite for local dev
# For PostgreSQL: postgresql://user:pass@localhost:5432/carbonchain
DATABASE_URL=sqlite:///./carbonchain_mumbai.db

# ─── Token Lifetimes ───
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS Origins (production only) ───
# Comma-separated list of allowed origins. Ignored in development (allows all).
# Example: https://carbonchain.in,https://www.carbonchain.in
ALLOWED_ORIGINS=

# ─── Backup (scripts/backup_db.py) ───
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=30
